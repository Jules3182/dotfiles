{
  "layer": "bottom",
  "output": "DP-3",
  "position": "top",

  "modules-left": ["custom/wallpaper", "group/blendertools"], //, "hyprland/window"
  "modules-center": ["custom/day", "clock", "custom/date"],
  "modules-right": ["group/quicktools","network#vpn", "bluetooth", "pulseaudio", "custom/power"],  

  "group/quicktools": {
    "orientation": "horizontal",
    "modules": ["custom/newnote", "custom/colorpicker", "custom/tuipom", "custom/counter"]
  },

  "group/blendertools": {
    "orientation": "horizontal",
    "modules": ["custom/blender", "custom/blender-notify"]
  },

  "clock": {
    "tooltip": false,
    "format": "{:%I:%M:%S}",
    "interval": 1,
    "on-click": "gnome-clocks"
  },
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"audio\"))'",
    "on-click-right": "pavucontrol"
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "",
    "format-connected": "󰂱",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%",
    "on-click": "rfkill toggle bluetooth",
    "on-click-right": "blueman-manager"
},
  "custom/day": {
    "exec": "date +'%a'",
    "interval": 60,
    "on-click": "gtk-launch WebApp-Reminders0631",
    "tooltip-format": "Today's To Do"
  },
  "custom/date": {
    "exec": "date +'%-m/%-d'",
    "interval": 60,
    "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"calendar\"))'",
    "on-click-right": "hyprctl eval 'hl.exec_cmd(\"gnome-calendar\")'", // Back up to restart the calendar if needed
    "tooltip-format": "Click to open calendar"
  },
  "custom/wallpaper": {
    "exec": "~/.config/hypr/scripts/wallpaper_icon.sh",
    "on-click": "~/.config/hypr/scripts/toggle_wallpaper.sh",
    "interval": 1
  },
  "custom/power": {
	"format" : "⏻",
	"tooltip-format": "Power Menu",
  "on-click": "eww active-windows | grep powermenu  && eww close powermenu  || eww open powermenu"
  },
  "custom/tuipom": {
	"format" : "󰀠",
	"tooltip-format": "Pomodoro Timer",
  "on-click": "hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"pomodoro\"))'",
  "on-click-right": "ghostty +new-window --title=pomodoro -e ~/.cargo/bin/timr-tui -m pomodoro"
  },
  "custom/colorpicker": {
	"format" : "󱏜",
	"tooltip-format": "Pick Color",
  "on-click": "hyprpicker -a -n"
  },
  "custom/newnote": {
	"format" : "󱞂",
	"tooltip-format": "New Obsidian Note",
  "on-click": "hyprctl clients | grep newnote  && hyprctl eval 'hl.dispatch(hl.dsp.workspace.toggle_special(\"newnote\"))'  || ghostty +new-window --title=newnote -e ~/.config/hypr/scripts/newnote.sh"
  },
  "network#vpn": {
    "interface": "wg0-mullvad",
    "format": "",
    "format-disconnected": "",
    "tooltip": false,
    "on-click": "mullvad status | grep Connected && mullvad disconnect || mullvad connect",
    "on-click-right": "/opt/Mullvad\\ VPN/mullvad-vpn & disown"
  },
  "custom/counter": {
    "exec": "~/.config/waybar/scripts/counter.sh",
    "return-type": "text",
    "interval": "once",
    "signal": 8,
    "format": "󰒾",
    "tooltip-format": "{}",
    "on-click": "",
    "on-scroll-up": "~/.config/waybar/scripts/counter-inc.sh",
    "on-scroll-down": "~/.config/waybar/scripts/counter-dec.sh"
  },
  "custom/blender": {
    "exec": "~/.config/waybar/scripts/waybar_progress.py",
    "return-type": "json",
    "interval": 1
  },
  "custom/blender-notify": {
    "exec": "~/.config/blender-progress/notify_icon.sh",
    "on-click": "~/.config/blender-progress/notify_toggle.sh",
    "interval": 1
  }
} 